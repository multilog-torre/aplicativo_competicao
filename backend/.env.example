# AMBIENTE & SERVIDOR
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# BANCO DE DADOS (PostgreSQL)
# Local/Docker: postgresql://postgres:postgres_secure_password@localhost:5432/gamificacao_db?schema=public
# Neon (produção/deploy gratuito): copie a "Connection string" do painel do Neon.
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/gamificacao_db?schema=public"

# AUTENTICAÇÃO E SEGURANÇA
# Gere valores próprios (ex.: `openssl rand -hex 32`) — nunca reutilize os de exemplo em produção.
JWT_SECRET=super_secret_jwt_key_torre_gamificacao_2026_dev_min32chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_token_torre_gamificacao_2026_dev
REFRESH_TOKEN_EXPIRES_IN=30d

# STORAGE DE EVIDÊNCIAS, AVATARES E FOTOS DO MURAL
# local: disco do servidor (só funciona em host com disco persistente).
# cloudinary: usado em hosts sem disco persistente (ex.: Render free tier) —
#   requer conta gratuita em https://cloudinary.com e as 3 variáveis abaixo.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=../storage/uploads
MAX_UPLOAD_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
