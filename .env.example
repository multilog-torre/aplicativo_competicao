# ==========================================
# SISTEMA CORPORATIVO DE GAMIFICAÇÃO - ENV EXAMPLE
# ==========================================

# AMBIENTE & SERVIDOR
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# BANCO DE DADOS (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=gamificacao_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/gamificacao_db?schema=public"

# AUTENTICAÇÃO E SEGURANÇA
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=30d

# SSO / AZURE AD (MICROSOFT ENTRA ID) - Opcional para dev local
AZURE_AD_CLIENT_ID=your_azure_client_id
AZURE_AD_TENANT_ID=your_azure_tenant_id
AZURE_AD_CLIENT_SECRET=your_azure_client_secret

# STORAGE DE EVIDÊNCIAS & ARQUIVOS (local | azure | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# AZURE BLOB STORAGE (se STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=gamificacao-evidencias

# AWS S3 (se STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=gamificacao-evidencias
